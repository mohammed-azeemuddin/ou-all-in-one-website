// Firestore security rules for OU All In One.
// Paste into Firebase console > Firestore Database > Rules > Publish.
//
// Everyone can read (the app and website read without signing in).
// Only the admin account can add, change or delete: the one that signs in at ouallinone.com/admin.
// Replace ADMIN_UID with that account's "User UID" from Firebase console > Authentication > Users.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'ADMIN_UID';
    }
  }
}
